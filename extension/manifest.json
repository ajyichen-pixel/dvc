{
  "manifest_version": 3,
  "name": "DVC Upload Guard",
  "version": "1.0.0",
  "description": "DVC browser upload de-identification test extension.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "DVC Upload Guard",
    "default_popup": "test.html"
  }
}
